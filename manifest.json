{
  "manifest_version": 3,
  "name": "Board Saver for Pinterest",
  "version": "1.0.0",
  "description": "Save every image on a Pinterest board in full quality. Duplicates removed, one ZIP download. Not affiliated with Pinterest.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*.pinterest.co.uk/*",
    "https://i.pinimg.com/*",
    "https://*.pinimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save this board",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}